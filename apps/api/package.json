{
  "name": "@lsg/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS — LS Global Assembleias (monólito modular)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node dist/main.js",
    "db:setup": "tsx src/db/setup.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@lsg/shared": "0.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.0",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "helmet": "8.3.0",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.3.1",
    "pg": "8.23.1",
    "pino": "^9.7.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15"
  }
}
