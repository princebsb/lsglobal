# =====================================================================
# LS Global Assembleias — variáveis de ambiente (copie para .env)
# NUNCA versionar o arquivo .env. Valores abaixo são exemplos locais.
# =====================================================================

NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL (instalação nativa, sem Docker) ---
# Conexão administrativa: usada SOMENTE por db:setup e db:migrate (cria bancos, papéis e esquema).
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5433/postgres
DB_NAME=lsglobal_assembleias
DB_TEST_NAME=lsglobal_assembleias_test
# Papel da aplicação: NÃO superusuário e sem BYPASSRLS, para que o Row-Level Security seja aplicado.
DB_APP_USER=lsg_app
DB_APP_PASSWORD=CHANGE_ME_APP
DB_POOL_MAX=20

# --- Segurança ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_xxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Chave AES-256-GCM (32 bytes em base64) para dados pessoais (CPF/CNPJ, segredo MFA).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Chave HMAC (base64) para índice cego de documentos (busca/deduplicação sem expor CPF).
DATA_HMAC_KEY=CHANGE_ME_BASE64_32_BYTES
# Exige MFA (TOTP) para perfis administrativos. Mantenha true em homologação/produção.
MFA_ENFORCE_ADMIN=false

# --- Armazenamento de arquivos (driver local; S3 compatível em fase posterior) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# --- Convocações (e-mail) ---
# URL pública do site usada nos links pessoais dos e-mails (padrão: primeira origem de WEB_ORIGIN).
# PUBLIC_WEB_URL=https://assembleias.exemplo.com.br
# "file" grava cada e-mail (.eml) em MAIL_OUTBOX_DIR sem enviar nada; "smtp" envia de verdade.
MAIL_DRIVER=file
MAIL_OUTBOX_DIR=./storage/outbox
MAIL_FROM=LS Global Assembleias <nao-responda@lsglobal.local>
# SMTP_URL=smtps://usuario:senha@smtp.provedor.com.br:465
# Processador da fila de envios (dentro da API). Desligue para rodar em processo separado.
OUTBOX_WORKER=true
OUTBOX_INTERVAL_MS=5000

# --- Transmissão (LiveKit auto-hospedado, binário nativo) ---
# Sem estas variáveis, a transmissão aparece como "não configurada".
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_PUBLIC_URL=wss://midia.exemplo.com.br   (URL vista pelo navegador; padrão = LIVEKIT_URL)
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=CHANGE_ME_MIN_32_CHARS_xxxxxxxxxxxxxxxx
# Gravação integral via LiveKit Egress (exige o serviço Egress rodando — ver docs/08).
LIVEKIT_EGRESS_ENABLED=false
RECORDINGS_DIR=./storage/recordings

# --- Opcional ---
# REDIS_URL=redis://localhost:6379   (necessário apenas para escalar o WebSocket horizontalmente)
LOG_LEVEL=info

# Pinggy (pinggy.bat): chave paga com sufixo do tunel da pagina
PINGGY_TOKEN=
